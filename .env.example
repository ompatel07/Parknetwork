# ─── Site ──────────────────────────────────────────────────────────
# Public URL used for SEO, sitemap and Open Graph (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.parklivenetwork.com

# ─── Email (Resend) — Phase 5 ──────────────────────────────────────
# https://resend.com → API Keys
RESEND_API_KEY=
# Sender address on a domain verified in Resend
EMAIL_FROM="Park Live Network <noreply@parklivenetwork.com>"

# ─── Spam protection (Cloudflare Turnstile) — Phase 5 ──────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Optional: shared rate limiting (Upstash Redis) ────────────────
# Without these, an in-memory limiter is used (per server instance).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
