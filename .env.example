# ─── Site ──────────────────────────────────────────────────────────
# Public URL used for SEO, sitemap and Open Graph (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.parklivenetwork.com

# ─── Supabase (blog, admin panel, form submissions) ────────────────
# Supabase dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
# "Publishable" key (sb_publishable_…) or the legacy "anon" key — safe in the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret" key (sb_secret_…) or the legacy "service_role" key — SERVER ONLY, keep private
SUPABASE_SECRET_KEY=

# ─── Email (Resend) ────────────────────────────────────────────────
# https://resend.com → API Keys. Sends form notifications and admin email replies.
RESEND_API_KEY=
# Sender address on a domain verified in Resend
EMAIL_FROM="Park Live Network <noreply@parklivenetwork.com>"

# ─── Spam protection (Cloudflare Turnstile) ────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Optional: shared rate limiting (Upstash Redis) ────────────────
# Without these, an in-memory limiter is used (per server instance).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
